#!/bin/bash
# Open a folder in Pilot from the terminal, like `code .`:
#   pilot            open the current folder (focuses its existing tab if any)
#   pilot ~/proj     open another folder
#   pilot -n .       force a brand-new session, even if a tab already exists
NEW=0
if [ "$1" = "-n" ] || [ "$1" = "--new" ]; then
  NEW=1
  shift
fi
TARGET="${1:-.}"
DIR=$(cd "$TARGET" 2>/dev/null && pwd)
if [ -z "$DIR" ]; then
  echo "pilot: no such folder: $TARGET" >&2
  exit 1
fi
ENCODED=$(python3 -c 'import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1]))' "$DIR")
open "pilot://open?path=$ENCODED&new=$NEW"
