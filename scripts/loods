#!/bin/bash
# Open a folder in Loods from the terminal, like `code .`:
#   loods            open the current folder (focuses its existing tab if any)
#   loods ~/proj     open another folder
#   loods -n .       force a brand-new session, even if a tab already exists
NEW=0
if [ "$1" = "-n" ] || [ "$1" = "--new" ]; then
  NEW=1
  shift
fi
TARGET="${1:-.}"
DIR=$(cd "$TARGET" 2>/dev/null && pwd)
if [ -z "$DIR" ]; then
  echo "loods: no such folder: $TARGET" >&2
  exit 1
fi
ENCODED=$(python3 -c 'import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1]))' "$DIR")
open "loods://open?path=$ENCODED&new=$NEW"
